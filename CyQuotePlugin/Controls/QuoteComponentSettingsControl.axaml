<controls:ComponentBase x:TypeArguments="models:QuoteComponentSettings"
                        x:Class="CyQuotePlugin.Controls.QuoteComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:CyQuotePlugin.Controls"
                        xmlns:models="clr-namespace:CyQuotePlugin.Models"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        mc:Ignorable="d"
                        d:DesignWidth="700">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:QuoteComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro" Spacing="8">
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="更换间隔" FontWeight="SemiBold" />
                        <TextBlock Text="单位为秒；0 表示关闭定时更换。" Opacity="0.65" />
                    </StackPanel>
                    <NumericUpDown Minimum="0" Maximum="86400" Increment="5"
                                   Grid.Column="1" Width="120"
                                   Value="{Binding Settings.ChangeIntervalSeconds, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="显示作者" FontWeight="SemiBold" />
                        <TextBlock Text="在语录后显示作者；语录未提供作者时不显示。" Opacity="0.65" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowAuthor, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="显示出处" FontWeight="SemiBold" />
                        <TextBlock Text="在语录后显示作品或来源；语录未提供出处时不显示。" Opacity="0.65" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowSource, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="单行显示" FontWeight="SemiBold" />
                        <TextBlock Text="将正文、作者和出处显示在同一行，不自动换行。" Opacity="0.65" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SingleLine, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="自适应排版" FontWeight="SemiBold" />
                        <TextBlock Text="单行放不下时自动降字号折行；仍放不下就在署名前加省略号，署名永远不会被截断。" Opacity="0.65" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AdaptiveLayout, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="最大行数" FontWeight="SemiBold" />
                        <TextBlock Text="折行后最多占几行，超出部分用省略号收住。" Opacity="0.65" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Width="120"
                                   Minimum="1" Maximum="4" Increment="1"
                                   Value="{Binding Settings.MaxLines, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="最小字号" FontWeight="SemiBold" />
                        <TextBlock Text="自动降字号时的下限，避免大屏上字太小看不清。" Opacity="0.65" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Width="120"
                                   Minimum="6" Maximum="72" Increment="1"
                                   Value="{Binding Settings.MinFontSize, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="可用高度" FontWeight="SemiBold" />
                        <TextBlock Text="折行块最多占多高；0 表示不限制。默认 45 对应 ClassIsland 行高 40 + 行距 5。" Opacity="0.65" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Width="120"
                                   Minimum="0" Maximum="500" Increment="5"
                                   Value="{Binding Settings.MaxBlockHeight, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="语句分类" FontWeight="SemiBold" />
                    <TextBlock Text="不选择即使用全部分类。" Opacity="0.65" />
                    <ItemsControl ItemsSource="{Binding CategoryOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="本地语录库" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CatalogSummary}" Opacity="0.65" />
                        </StackPanel>
                    <Button Content="立即同步"
                            Grid.Column="1"
                            IsEnabled="{Binding CanSync}"
                            Click="OnSyncClick" />
                    </Grid>
                    <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
