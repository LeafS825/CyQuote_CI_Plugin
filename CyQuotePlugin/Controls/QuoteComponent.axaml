<controls:ComponentBase x:TypeArguments="models:QuoteComponentSettings"
                        x:Class="CyQuotePlugin.Controls.QuoteComponent"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:CyQuotePlugin.Controls"
                        xmlns:models="clr-namespace:CyQuotePlugin.Models"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        mc:Ignorable="d"
                        d:DesignWidth="600"
                        PointerPressed="OnPointerPressed">
    <!--
        语录与署名合并为一个字段，由 QuoteLayout 统一决定：单行 / 降字号折行 / 在署名前断句省略。
        ClipToBounds 兜底：万一哪次判断失手，宁可裁掉也不要画到隔壁组件上。
        MaxWidth 必须给——ClassIsland 行内组件是无限宽测量的，没有它 Wrap 和 Trimming 都不会生效。
    -->
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:QuoteComponent}}"
          ClipToBounds="True">
        <TextBlock x:Name="QuoteTextBlock"
                   Text="{Binding DisplayText}"
                   FontSize="{Binding DisplayFontSize}"
                   MaxWidth="{Binding DisplayMaxWidth}"
                   TextWrapping="{Binding DisplayWrapping}"
                   MaxLines="{Binding DisplayMaxLines}"
                   TextTrimming="{Binding DisplayTrimming}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</controls:ComponentBase>
